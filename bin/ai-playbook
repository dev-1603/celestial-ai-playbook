#!/usr/bin/env node

import fs from 'fs';
import path from 'path';
import { spawnSync } from 'child_process';
import { fileURLToPath } from 'url';
import { cliResult } from '../scripts/lib/global-paths.mjs';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const REPO_ROOT = path.resolve(__dirname, '..');
const SRC_DIR = path.join(REPO_ROOT, 'src');
const VERSION = '3.0.0';

const args = process.argv.slice(2);
const command = args[0];

function help() {
  console.log(`
Celestial AI Context Orchestrator v${VERSION}

Usage: ai-playbook <command> [args]

Commands:
  install                         Global install: Cursor rules, skills, commands (~/.cursor/)
  install-all [targets]           Global install for all IDEs (cursor, claude, copilot, antigravity, roles)
  generate-rules <abs-path>       Generate project-local rules via orchestrator-workers workflow
    --selectors /role/x /lang/y   Required selectors (max 8)
  export-roles                    Export roles globally to all IDE command dirs
    --target <t>                  Filter target (cursor, claude, copilot, antigravity)
    --project <abs-path>          Explicit project path (opt-in; default is global)
  manifest                        Show component taxonomy
  validate                        Validate playbook structure
  list [category]                 List available components
  create <category> <name>        Scaffold a new playbook component
  remove <category> <name>        Remove a component
  verify-roles                    Run role export verification
  verify-frontmatter              Run frontmatter parser tests
  verify-skill-resolver           Run skill resolver JIT tests
  eval                            Run full eval suite
  help                            Show this help
`);
}

function runScript(scriptRel, scriptArgs = []) {
  const scriptPath = path.join(REPO_ROOT, scriptRel);
  if (!fs.existsSync(scriptPath)) {
    console.error(`ERROR: Script not found: ${scriptPath}`);
    process.exit(1);
  }
  const result = spawnSync('node', [scriptPath, ...scriptArgs], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

function scanComponents(dirPath) {
  if (!fs.existsSync(dirPath)) return [];
  return fs.readdirSync(dirPath, { withFileTypes: true })
    .filter(e => e.isFile() && e.name.endsWith('.md'))
    .map(e => e.name.replace('.md', ''))
    .sort();
}

if (!command || command === 'help') {
  help();
  process.exit(0);
}

switch (command) {
  case 'install':
    runScript('scripts/install-cursor.mjs', ['global']);
    break;

  case 'install-all':
    runScript('scripts/install-all-ides.mjs', args.slice(1));
    break;

  case 'generate-rules': {
    const projectArg = args[1];
    if (!projectArg || projectArg.startsWith('--')) {
      process.exit(cliResult(false, 'Usage: generate-rules <abs-project-path> --selectors /role/x ...'));
    }
    const absProject = path.resolve(projectArg);
    if (!path.isAbsolute(absProject)) {
      process.exit(cliResult(false, 'Project path must be absolute'));
    }
    runScript('scripts/project-rule-generator/index.mjs', args.slice(1));
    break;
  }

  case 'export-roles':
    runScript('scripts/export-roles.mjs', ['--global', ...args.slice(1)]);
    break;

  case 'manifest': {
    const manifest = JSON.parse(fs.readFileSync(path.join(REPO_ROOT, 'playbook.manifest.json'), 'utf-8'));
    const byType = { rule: [], skill: [], command: [] };
    for (const [key, config] of Object.entries(manifest.components)) {
      byType[config.type]?.push({ key, ...config });
    }
    console.log('\nCelestial Playbook Taxonomy\n');
    for (const [type, items] of Object.entries(byType)) {
      console.log(`── ${type.toUpperCase()} (${items.length}) ──`);
      for (const item of items) {
        const extra = item.command ? ` → /${item.command}` : item.globs ? ` [${item.globs}]` : item.scope === 'project' ? ' [project-only]' : '';
        console.log(`  ${item.key}${extra}`);
      }
      console.log('');
    }
    console.log('OK: Manifest displayed');
    process.exit(0);
  }

  case 'validate': {
    const dirs = ['base', 'architecture', 'roles', 'languages', 'frameworks', 'design-patterns', 'skills'];
    let valid = true;
    for (const dir of dirs) {
      if (!fs.existsSync(path.join(SRC_DIR, dir))) {
        console.error(`ERROR: Missing directory: src/${dir}`);
        valid = false;
      }
    }
    process.exit(valid ? cliResult(true, 'Validation passed') : cliResult(false, 'Validation failed'));
  }

  case 'list': {
    const category = args[1];
    if (category && category !== 'all') {
      const components = scanComponents(path.join(SRC_DIR, category));
      console.log(`\n${category.toUpperCase()}:`);
      components.forEach(c => console.log(` - ${c}`));
    } else {
      for (const dir of fs.readdirSync(SRC_DIR, { withFileTypes: true }).filter(d => d.isDirectory())) {
        console.log(`\n--- ${dir.name.toUpperCase()} ---`);
        scanComponents(path.join(SRC_DIR, dir.name)).forEach(c => console.log(` - ${c}`));
      }
    }
    console.log('OK: List complete');
    process.exit(0);
  }

  case 'create': {
    const category = args[1];
    const name = args[2];
    if (!category || !name) {
      process.exit(cliResult(false, 'Usage: create <category> <name>'));
    }
    const targetDir = path.join(SRC_DIR, category);
    if (!fs.existsSync(targetDir)) {
      process.exit(cliResult(false, `Category '${category}' does not exist`));
    }
    const targetFile = path.join(targetDir, `${name}.md`);
    if (fs.existsSync(targetFile)) {
      process.exit(cliResult(false, `File already exists: src/${category}/${name}.md`));
    }
    fs.writeFileSync(targetFile, `---
name: ${name}
description: TODO
scope: global
type: rule
triggers: [${name}]
token_budget: 400
---

## TODO

Scaffold — add real content.
`);
    console.log(`OK: Created src/${category}/${name}.md`);
    process.exit(0);
  }

  case 'remove': {
    const category = args[1];
    const name = args[2];
    if (!category || !name) {
      process.exit(cliResult(false, 'Usage: remove <category> <name>'));
    }
    const targetDir = path.join(SRC_DIR, category);
    if (name === 'all') {
      let count = 0;
      for (const file of fs.readdirSync(targetDir)) {
        if (file.endsWith('.md')) { fs.unlinkSync(path.join(targetDir, file)); count++; }
      }
      console.log(`OK: Removed ${count} files from src/${category}/`);
    } else {
      const targetFile = path.join(targetDir, `${name}.md`);
      if (!fs.existsSync(targetFile)) {
        process.exit(cliResult(false, `File not found: src/${category}/${name}.md`));
      }
      fs.unlinkSync(targetFile);
      console.log(`OK: Removed src/${category}/${name}.md`);
    }
    process.exit(0);
  }

  case 'verify-roles':
    runScript('scripts/verify-role-exports.mjs');
    break;

  case 'verify-frontmatter':
    runScript('scripts/verify-frontmatter.mjs');
    break;

  case 'verify-skill-resolver':
    runScript('scripts/verify-skill-resolver.mjs');
    break;

  case 'eval':
    runScript('scripts/eval/run-eval.mjs');
    break;

  // Deprecated — explicit errors
  case 'sync':
  case 'export':
    process.exit(cliResult(false, `'${command}' removed. Use 'generate-rules <abs-path> --selectors ...'`));
  case 'switch':
    process.exit(cliResult(false, `'switch' removed. Use 'generate-rules <abs-path> --selectors /role/<name> /base'`));
  case 'export-claude':
  case 'export-copilot':
  case 'export-antigravity':
    process.exit(cliResult(false, `'${command}' removed. Use 'install-all' for global multi-IDE install'`));

  default:
    process.exit(cliResult(false, `Unknown command '${command}'. Run 'ai-playbook help'.`));
}
